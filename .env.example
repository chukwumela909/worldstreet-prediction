# All optional: with everything unset the app runs in demo mode (mock email
# sign-in + localStorage portfolio). Fill in at deploy time.

# --- Central auth (Clerk on worldstreetgold.com) ---
# Same Clerk application as the other WorldStreet platforms. Setting the
# publishable key switches the app from mock auth to Clerk satellite SSO.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Defaults baked into lib/auth-config.ts; override only if they change.
# NEXT_PUBLIC_CLERK_DOMAIN=worldstreetgold.com
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://www.worldstreetgold.com/login
# Funding page for the central dollar wallet, linked from the credit dialog's
# "Fund your WorldStreet wallet". Defaults to the WorldStreet site root.
# NEXT_PUBLIC_WALLET_FUND_URL=https://www.worldstreetgold.com

# --- Prediction backend (services/api) ---
# e.g. https://prediction-api.worldstreetgold.com — unset = mock cash/portfolio.
#
# International (Polymarket) trading ships OFF and is switched on by an admin
# from the admin Settings page once the API is deployed and its Polymarket
# smoke test passes (`npm run smoke:polymarket` in services/api). The spread,
# stake limits and exposure cap are set there too; the API's env vars
# (POLYMARKET_SPREAD_BPS etc.) are only their starting defaults. The web app
# reads all of it from GET /v1/markets/pricing within about a minute — nothing
# to set here, no rebuild. Unset, unreachable, or an older API = display-only.
NEXT_PUBLIC_API_URL=
